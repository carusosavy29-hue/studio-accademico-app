* {
  box-sizing: border-box;
}

:root {
  --bg: #091425;
  --panel: rgba(16, 25, 38, 0.92);
  --panel-alt: rgba(25, 37, 52, 0.9);
  --surface: #0f172a;
  --surface-strong: #111827;
  --line: rgba(148, 163, 184, 0.2);
  --text: #e2e8f0;
  --muted: #94a3b8;
  --primary: #7c3aed;
  --primary-soft: rgba(124, 58, 237, 0.18);
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  font-family: Inter, 'Segoe UI', sans-serif;
  background:
    radial-gradient(circle at top, rgba(124, 58, 237, 0.22), transparent 25%),
    linear-gradient(180deg, #030712 0%, #0b1120 100%);
  color: var(--text);
}

button, input, textarea, select {
  font: inherit;
}

button {
  cursor: pointer;
}

textarea, input, select {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 0.9rem 1rem;
  background: rgba(15, 23, 42, 0.9);
  color: var(--text);
  outline: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

textarea:focus, input:focus, select:focus {
  border-color: rgba(124, 58, 237, 0.8);
  box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.18);
}

.app-shell {
  max-width: 1600px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 360px minmax(0, 1fr);
  min-height: 100vh;
  gap: 1.5rem;
  padding: 1.5rem;
}

.sidebar,
.main-panel {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.card {
  background: rgba(15, 23, 42, 0.92);
  border: 1px solid var(--line);
  border-radius: 20px;
  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.22);
  padding: 1.1rem 1.2rem;
}

.brand-box {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.22), rgba(20, 184, 166, 0.15));
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 1rem 1.1rem;
}

.brand-badge {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: linear-gradient(135deg, #8b5cf6, #14b8a6);
  color: white;
  font-size: 1.4rem;
  font-weight: 800;
}

.eyebrow {
  margin: 0 0 0.2rem;
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}

h1, h2, h3, p {
  margin: 0;
}

h1 {
  font-size: 1.5rem;
}

.section-card {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.subject-list {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.subject-pill {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  border: 1px solid transparent;
  background: rgba(148, 163, 184, 0.08);
  border-radius: 12px;
  padding: 0.7rem 0.8rem;
  color: var(--text);
  text-align: left;
}

.subject-pill.active {
  border-color: rgba(124, 58, 237, 0.6);
  background: rgba(124, 58, 237, 0.12);
}

.subject-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}

.primary-button,
.secondary-button {
  border-radius: 12px;
  padding: 0.8rem 1rem;
  border: 1px solid transparent;
  font-weight: 700;
  transition: transform 0.15s ease;
}

.primary-button {
  background: linear-gradient(135deg, #8b5cf6, #3b82f6);
  color: white;
}

.secondary-button {
  background: rgba(148, 163, 184, 0.08);
  color: var(--text);
  border-color: var(--line);
}

.primary-button:hover,
.secondary-button:hover {
  transform: translateY(-1px);
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
}

.verdict-pill {
  padding: 0.6rem 0.9rem;
  border-radius: 999px;
  border: 2px solid;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.verdict-pill.promosso {
  background: rgba(16, 185, 129, 0.12);
}

.verdict-pill.rimandato {
  background: rgba(245, 158, 11, 0.12);
}

.verdict-pill.bocciato {
  background: rgba(239, 68, 68, 0.12);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
}

.small-gap {
  margin-bottom: 0.8rem;
}

.section-tag {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 0.45rem 0.7rem;
  font-size: 0.75rem;
  font-weight: 700;
}

.notes-panel {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.content-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}

.panel-box {
  min-height: 100%;
}

.question-box,
.oral-box {
  background: rgba(148, 163, 184, 0.05);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 0.8rem 0.9rem;
  margin-bottom: 0.9rem;
}

.question-box strong,
.oral-box strong {
  display: block;
  margin-bottom: 0.4rem;
}

.question-box p,
.oral-box p {
  line-height: 1.6;
  color: #dfe7f1;
}

textarea {
  resize: vertical;
  min-height: 130px;
}

.sheet-wrapper {
  margin-top: 1rem;
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  color: var(--muted);
  margin-bottom: 0.6rem;
}

.paper-sheet {
  position: relative;
  background: linear-gradient(180deg, #fff9db, #fff3b0);
  border: 1px solid rgba(120, 113, 108, 0.4);
  border-radius: 18px;
  color: #1f2937;
  padding: 1.1rem 1rem 1.4rem;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
  overflow: hidden;
}

.paper-sheet::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(239, 68, 68, 0.08) 50%, transparent 100%);
  pointer-events: none;
}

.question-title {
  font-weight: 800;
  margin-bottom: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.72rem;
  color: rgba(31, 41, 55, 0.72);
}

.answer-block {
  position: relative;
  z-index: 1;
  margin-top: 0.8rem;
  line-height: 1.9;
  font-size: 0.96rem;
  white-space: pre-wrap;
}

.red-pen-word {
  text-decoration: underline wavy #ef4444;
  background: rgba(239, 68, 68, 0.08);
  padding: 0 2px;
}

.annotation-block {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-top: 1rem;
  padding-top: 0.8rem;
  border-top: 1px dashed rgba(31, 41, 55, 0.32);
}

.annotation {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: #7f1d1d;
  font-weight: 600;
}

.red-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #ef4444;
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12);
}

.speech-controls {
  margin-bottom: 0.8rem;
}

.report-card {
  margin-top: 0.25rem;
}

.stamp {
  display: grid;
  place-items: center;
  width: 140px;
  height: 140px;
  border-radius: 50%;
  border: 6px solid;
  font-size: 1.05rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transform: rotate(-12deg);
  background: rgba(255, 255, 255, 0.02);
}

.report-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1rem;
  margin-top: 1rem;
}

.report-item {
  background: rgba(148, 163, 184, 0.04);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 1rem;
}

.report-header {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  margin-bottom: 0.8rem;
}

.score-row {
  display: flex;
  justify-content: space-between;
  padding: 0.55rem 0;
  border-bottom: 1px solid rgba(148, 163, 184, 0.14);
  color: var(--muted);
}

.total-row {
  color: var(--text);
  border-bottom: none;
  margin-top: 0.3rem;
  font-weight: 700;
}

.overall-summary {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 1rem;
  border-top: 1px solid var(--line);
  padding-top: 1rem;
}

.overall-summary div {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  color: var(--muted);
}

.overall-summary strong {
  color: var(--text);
  font-size: 1.2rem;
}

@media (max-width: 1100px) {
  .app-shell {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 800px) {
  .content-grid {
    grid-template-columns: 1fr;
  }

  .topbar,
  .section-header,
  .overall-summary {
    flex-direction: column;
    align-items: flex-start;
  }
}
